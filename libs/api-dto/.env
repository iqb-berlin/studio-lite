# The DTOs carry @nestjs/swagger decorators, and NestJS 12 ships as ES modules, so this library's
# jest run needs Node's ESM support in the VM just like the api's (see apps/api/.env). Nx reads
# this file before it starts a task for this project. Without it every spec that imports the
# barrel fails to parse. A NODE_OPTIONS already set in the shell wins over this one;
# jest.vm-modules.cjs then stops the run and says so (#2031).
NODE_OPTIONS=--experimental-vm-modules
