# Version
TAG=latest

# Image Registry Path
## Docker Hub:       (aka registry-1.docker.io/) leave REGISTRY_PATH value empty!
## Docker Hub Proxy: scm.cms.hu-berlin.de:443/iqb/dependency_proxy/containers/
## GitLab:           scm.cms.hu-berlin.de:4567/iqb/studio-lite/
REGISTRY_PATH=scm.cms.hu-berlin.de:443/iqb/dependency_proxy/containers/

# Ingress
SERVER_NAME=localhost

# Frontend
HTTP_PORT=4200

# Gateway (iqb-gate) in front of the frontend: every save and every login only from people.
## Started only with the profile gate; reach the studio through it at http://localhost:GATE_PORT.
## The image is built from the iqb-gate repository until it is published (see README).
#COMPOSE_PROFILES=gate
GATE_PORT=4300
IQB_GATE_ENFORCE=on
## Rules switched off, comma-separated: login, administration, workspace, review, account, other
## (config/iqb-gate/gate.yaml). Takes effect with: docker compose --env-file .env.dev up -d iqb-gate
IQB_GATE_RULES_OFF=
IQB_GATE_SECRET=dev-only-secret-of-at-least-32-characters
## Password of the audit page http://localhost:GATE_PORT/.iqb-gate/admin/ (any user name)
IQB_GATE_AUDIT_KEY=dev-only-audit-key-of-at-least-32-characters

# Backend
API_PORT=3333
JWT_SECRET=random_256_bit_string_base64_encoded

# Database
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root-password
POSTGRES_DB=studio-lite

## DB Volume: Select 'db_vol' to use the default docker volume, or 'db_external_vol' if you want to use block storage.
DB_VOL=db_vol
## Enter the path of your external storage device. Only required if you are NOT using the default Docker volume.
DB_EXTERNAL_VOL_PATH=/path/to/your/block/storage/db/data/volume
