# NestJS 12 ships as ES modules, so the api's jest run needs Node's ESM support in the VM.
# Nx reads this file before it starts a task for this project, which is what puts the flag on
# the jest workers. Without it every spec that touches a @nestjs package fails to parse.
# A NODE_OPTIONS already set in the shell wins over this one; jest.vm-modules.cjs then stops
# the run and says so (#2031).
NODE_OPTIONS=--experimental-vm-modules
