# Version
TAG=latest

# Image Registry Path
## Docker Hub:       (aka registry-1.docker.io/) leave REGISTRY_PATH value empty!
## Docker Hub Proxy: scm.cms.hu-berlin.de:443/iqb/dependency_proxy/containers/
## GitLab:           scm.cms.hu-berlin.de:4567/iqb/studio-lite/
REGISTRY_PATH=

# Ingress
## The Server Name and the TLS Certificates Resolvers are defined and configured in the Traefik project.
## 'SERVER_NAME' and 'TLS_CERTIFICATE_RESOLVER' have to be in sync with the 'SERVER_NAME' and 'TLS_CERTIFICATE_RESOLVER'
## in the '.env.traefik' file located at TRAEFIK_DIR (see below)!
SERVER_NAME=base_domain.org
TRAEFIK_DIR=

## TLS_CERTIFICATE_RESOLVER Settings:
### Leave it empty for user-defined certificates, or choose
### 'acme', if you want to use an acme-provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER=

# Gateway (iqb-gate): Traefik asks it about every request (ForwardAuth); every save, login and API
# read only from people. Traefik has to end TLS: the gateway learns from it that a request came over
# HTTPS.
## Version of the image iqbberlin/iqb-gate.
IQB_GATE_TAG=latest
## At least 32 characters, e.g. openssl rand -hex 32. Signs its cookies and challenges.
IQB_GATE_SECRET=
## Password of the audit page https://SERVER_NAME/.iqb-gate/admin/ (any user name); at least 32
## characters. Empty: no audit page.
IQB_GATE_AUDIT_KEY=
## The subnet of the network app-net, where Traefik sits, e.g. 172.18.0.0/16; install and update
## fill it in from docker network inspect app-net (IPAM > Config > Subnet). The gateway believes
## X-Forwarded-* from there only: empty, all users share one challenge limit.
IQB_GATE_TRUST_PROXY=
## off switches the check off, e.g. for test runs with Cypress.
IQB_GATE_ENFORCE=on
## Rules switched off, comma-separated, e.g. workspace. The rules: login, administration, workspace,
## review, account, other (config/iqb-gate/gate.yaml). Empty: everything is checked.
IQB_GATE_RULES_OFF=
## The same for reads, independent of the writes. The read rules: administration, workspace, review,
## account, other. Empty: every API read is checked.
IQB_GATE_READ_RULES_OFF=

# Backend
JWT_SECRET=random_256_bit_string_base64_encoded

# Database
POSTGRES_USER=root
POSTGRES_PASSWORD=root-password
POSTGRES_DB=studio-lite

## DB Volume: Select 'db_vol' to use the default docker volume, or 'db_external_vol' if you want to use block storage.
DB_VOL=db_vol

## Enter the path of your external storage device. Only required if you are NOT using the default Docker volume.
DB_EXTERNAL_VOL_PATH=/path/to/your/block/storage/db/data/volume
